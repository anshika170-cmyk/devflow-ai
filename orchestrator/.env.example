# DevFlow AI Orchestrator — environment variables
# Copy this file to .env and fill in values for your environment.
# The application runs fully in Demo Mode (local static analysis) when
# BOB_API_URL is not set — no API key is required for the MVP demo.

# -------------------------------------------------------------------
# IBM Bob 2.0 Integration (optional — enables live AI analysis)
# -------------------------------------------------------------------
# Set BOB_API_URL to your IBM Bob 2.0 agent endpoint to enable real
# AI-powered analysis instead of local static analysis.
# Every agent checks isBobConfigured() first; if not set, the agent
# falls back to deterministic local analysis automatically.
#
# BOB_API_URL=https://your-bob-instance.example.com
# BOB_API_KEY=your-api-key-here

# -------------------------------------------------------------------
# Server configuration
# -------------------------------------------------------------------
# Port the DevFlow AI orchestrator listens on (default: 4100)
# PORT=4100
